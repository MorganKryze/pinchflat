<.simple_form
  :let={f}
  for={@changeset}
  action={@action}
  x-data="{ advancedMode: !!JSON.parse(localStorage.getItem('advancedMode')) }"
  x-init="$watch('advancedMode', value => localStorage.setItem('advancedMode', JSON.stringify(value)))"
>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>

  <section>
    <section class="flex justify-between items-center mt-4">
      <h3 class="text-2xl text-black dark:text-white">
        Notification Settings
      </h3>
      <span class="cursor-pointer hover:underline" x-on:click="advancedMode = !advancedMode">
        Editing Mode: <span x-text="advancedMode ? 'Advanced' : 'Standard'"></span>
      </span>
    </section>

    {live_render(
      @conn,
      Pinchflat.Settings.AppriseServerLive,
      session: %{"value" => f[:apprise_server].value}
    )}
  </section>

  <section class="mt-8">
    <section>
      <h3 class="text-2xl text-black dark:text-white">
        Extractor Settings
      </h3>

      <.input
        field={f[:youtube_api_key]}
        placeholder="ABC123,DEF456"
        type="text"
        label="YouTube API Key(s)"
        help={youtube_api_help()}
        html_help={true}
        inputclass="font-mono text-sm mr-4"
      />

      <.input
        field={f[:extractor_sleep_interval_seconds]}
        placeholder="0"
        type="number"
        label="Sleep Interval (seconds)"
        help="Sleep interval in seconds between each extractor request. Must be a positive whole number. Set to 0 to disable"
      />

      <.input
        field={f[:download_throughput_limit]}
        placeholder="4.2M"
        label="Download Throughput"
        help="Sets the max bytes-per-second throughput when downloading media. Examples: '50K' or '4.2M'. Leave blank to disable"
      />

      <.input
        field={f[:download_max_attempts]}
        placeholder="20"
        type="number"
        label="Download Retry Attempts"
        help="How many times a failed download is retried before it is left for the next index to reconsider. Between 1 and 20. Lower this if you also set a retry backoff base, since the delays grow very fast"
      />

      <.input
        field={f[:download_retry_backoff_base_seconds]}
        placeholder="Leave blank for the default"
        type="number"
        label="Retry Backoff Base (seconds)"
        help="Leave blank to space retries the normal way, which packs the early attempts into about twenty minutes. Set a number to spread them much further instead, as base x attempt^4 - at 30 the gaps become roughly 30s, 8min, 40min then 2h, which outlasts an IP throttle rather than being spent inside one"
      />

      <.input
        field={f[:apply_yt_dlp_config_to_all_commands]}
        type="toggle"
        label="Apply yt-dlp Config Files To Indexing"
        help="Your yt-dlp config files reach downloads only. Turn this on and they also reach indexing and metadata, which on a busy instance is most of the calls made and the ones that draw the most refusals. Useful for a plugin directory, a socket timeout or a player-client override; check first that your config holds nothing that only makes sense while downloading"
      />

      <.input
        field={f[:set_aside_permanent_failures]}
        type="toggle"
        label="Set Aside Permanent Failures"
        help="Take a media item out of rotation when it fails for a reason that can never succeed - deleted, private, members-only, age-restricted - instead of retrying it at every index forever. The reason is recorded and the item can be re-enabled by hand. Off by default, since a video can be un-privated and an age restriction can be lifted"
      />

      <.input
        field={f[:download_backoff_enabled]}
        type="toggle"
        label="Pause When Throttled"
        help="When YouTube starts refusing requests from this address, stop all yt-dlp queues for a while instead of burning through the queue on refusals. Off by default, since it stops work on its own"
      />

      <.input
        field={f[:download_backoff_threshold]}
        placeholder="5"
        type="number"
        label="Throttle Pause Threshold"
        help="How many throttled downloads, with nothing at all succeeding, before the queues stop"
      />

      <.input
        field={f[:download_backoff_minutes]}
        placeholder="30"
        type="number"
        label="Throttle Pause Minutes"
        help="How long to stop for, and also how far back the threshold looks: 'if the last 30 minutes were nothing but refusals, stop for 30 minutes'. If the block outlasts it, the next failure stops the queues again"
      />

      <.input
        field={f[:download_backoff_probe_enabled]}
        type="toggle"
        label="Ask Before Resuming"
        help="When the pause is up, ask YouTube one question before starting the queues again, and keep waiting if the answer is still a refusal. Costs one request every pause instead of another threshold's worth of refused downloads. Off by default, since a plain pause ends on the clock and decides nothing"
      />

      <.input
        field={f[:download_backoff_escalate]}
        type="toggle"
        label="Wait Longer After Each Refusal"
        help="Only does anything when the above is on. Each refused question makes the next wait longer, up to four times the pause length, so a long block costs a handful of requests spread out rather than a steady two an hour. Turn it off to keep asking at a fixed interval, which starts again sooner and asks far more often"
      />

      <.input
        field={f[:forced_download_priority]}
        placeholder="5"
        type="number"
        label="Forced Retry Priority"
        help="Queue priority given to 'Force Download Pending', from 0 to 9. Jobs run in priority order before queue order, so at the default of 5 a forced retry waits behind everything already queued - which on a busy source can be days. Set 0 to run them first"
      />

      <.input
        field={f[:restrict_filenames]}
        type="toggle"
        label="Restrict Filenames"
        help="Restrict filenames to only ASCII characters and avoid ampersands/spaces in filenames"
      />
    </section>
  </section>

  <section class="mt-8" x-show="advancedMode">
    <section>
      <h3 class="text-2xl text-black dark:text-white">
        Codec Options
      </h3>

      <p class="text-sm mt-2 max-w-prose">
        The best available codec will be used if your preferred codecs are not found
      </p>

      <.input
        field={f[:video_codec_preference]}
        placeholder="avc"
        type="text"
        label="Video Codec Preference"
        help="Video codec preference. Will be remuxed into an MP4 container. See below for more details"
        inputclass="font-mono text-sm mr-4"
      />

      <.input
        field={f[:audio_codec_preference]}
        placeholder="m4a"
        type="text"
        label="Audio Codec Preference"
        help="Audio codec preference. See below for more details"
        inputclass="font-mono text-sm mr-4"
      />
    </section>

    <div class="rounded-sm dark:bg-meta-4 p-4 md:p-6 mt-5">
      <.codec_settings_help />
    </div>
  </section>

  <.button class="mt-10 mb-4 sm:mb-8 w-full sm:w-auto" rounding="rounded-lg">Save Settings</.button>
</.simple_form>
